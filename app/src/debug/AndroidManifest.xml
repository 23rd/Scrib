<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The debug receiver can act as an Open Transcribe client (API_TRANSCRIBE against another
         installed implementation), which needs package visibility on API 30+. -->
    <queries>
        <intent>
            <action android:name="org.opentranscribe.api.ITranscriptionService"/>
        </intent>
    </queries>

    <application>
        <receiver
            android:name=".TestCommandsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.scrib.transcriber.test.STATE"/>
                <action android:name="org.scrib.transcriber.test.OPEN_TAB"/>
                <action android:name="org.scrib.transcriber.test.TRANSCRIBE"/>
                <action android:name="org.scrib.transcriber.test.IMPORT_MODEL"/>
                <action android:name="org.scrib.transcriber.test.API_TRANSCRIBE"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
