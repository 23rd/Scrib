<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- A transcription outlives the screen that started it, and says so in the shade. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Everything but the built-in recorder works without one. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scrib">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Scrib">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="audio/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="application/ogg"/>
            </intent-filter>
        </activity>

        <service
            android:name=".TranscriptionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <activity
            android:name=".DictionaryActivity"
            android:exported="false"
            android:theme="@style/Theme.Scrib"/>

        <service
            android:name=".TranscriptionService"
            android:exported="true">
            <intent-filter>
                <action android:name="org.opentranscribe.api.ITranscriptionService"/>
            </intent-filter>
        </service>

        <!-- Only the system may bind an input method, which is what the permission below says. -->
        <service
            android:name=".ScribInputMethodService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method"/>
        </service>
    </application>
</manifest>
